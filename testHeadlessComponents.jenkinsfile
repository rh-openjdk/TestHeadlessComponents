properties([
    parameters([
        string(name: 'executionId', defaultValue: UUID.randomUUID().toString(), description: 'Unique execution ID'),
        string(name: 'ebcShortlist', defaultValue: 'rh-openjdk-qe-rhel9-jenkins_medium.yml',
               description: 'This controls the EBC shortlist to use when provisioning a Jenkins node.'),
        string(name: 'ecosystemTracking', defaultValue: "",
               description: 'Tracking Map as string often containing information about CI Orchestrator pipeline'),
        string(name: 'JENKINS_JOBS_BRANCH', defaultValue: 'dev', description: 'Branch of Jenkins jobs to use for scripts execution'),
        string(name: 'JENKINS_JOBS_ORG', defaultValue: 'cognitive-software-delivery', description: 'GitHub Org of Jenkins jobs to use for scripts execution'),
        string(name: 'TEST_SUITE_BRANCH', defaultValue: 'dev', description: 'Branch to test'),
        string(name: 'TEST_SUITE_URL',
               defaultValue: 'https://github.com/rh-openjdk/TestHeadlessComponents.git',
               description: 'URL to download for prepared suites'),
        string(name: 'TEST_COMMAND',
               defaultValue: 'export TEST_JDK_HOME=/usr/lib/jvm/java-17-openjdk JAVA_TO_TEST=/usr/lib/jvm/java-17-openjdk/bin/java OJDK_VERSION_NUMBER=17 JREJDK=jdk TMPRESULTS=tmpresults ; bash testHeadlessComponents.sh ; ls',
               description: 'Test command to execute on the target machine'),
        string(name: 'GET_JAVA_COMMAND',
               defaultValue: 'sudo dnf install -y java-17-openjdk-devel',
               description: 'Not used at the moment'),
        string(name: 'FILE_SERVER', defaultValue: '',
               description: 'File server where the final results and artifacts will be stored for Cognitive UI'),
        string(name: 'JVM_UNDER_TEST_PATH', defaultValue: '',
               description: 'The location on the fileserver to find the java we want to test against'),
        string(name: 'REPORTING_JVM', defaultValue: 'REDHAT_JDK_21',
               description: 'The JVM value to report to cognitive'),

        // --- Koji-SCM parameters (all editable at runtime) ---
        string(name: 'KOJI_TOP_URLS',
               defaultValue: 'https://koji.fedoraproject.org/kojihub',
               description: 'Space-separated Koji/Brew hub (XML-RPC) URLs; first reachable is used'),
        string(name: 'KOJI_DOWNLOAD_URLS',
               defaultValue: 'https://kojipkgs.fedoraproject.org/packages/',
               description: 'Space-separated base URLs to download artifacts (first that contains files is used)'),
        string(name: 'KOJI_PACKAGE_NAME',
               defaultValue: 'java-latest-openjdk',
               description: 'Package name(s) to watch (space-separated)'),
        string(name: 'KOJI_PACKAGE_TAG',
               defaultValue: '',
               description: 'Glob for allowed tags (empty = all)'),
        string(name: 'KOJI_PACKAGE_ARCH',
               defaultValue: 'x86_64',
               description: 'Comma-separated architectures; leave empty for all'),
        string(name: 'KOJI_TAG',
               defaultValue: '',
               description: 'Tag glob; leave empty to match all'),
        string(name: 'KOJI_SUBPACKAGE_DENYLIST',
               defaultValue: '.*debug.*,.*src.*',
               description: 'Subpackage patterns to exclude (glob set or comma-separated)'),
        string(name: 'KOJI_SUBPACKAGE_ALLOWLIST',
               defaultValue: '',
               description: 'Subpackage patterns to allow (optional; empty = all)'),

        // --- Download behavior ---
        string(name: 'KOJI_DOWNLOAD_DIR',
               defaultValue: 'koji-drop',
               description: 'Workspace subdir to place downloaded artifacts (empty = workspace root)'),
        string(name: 'KOJI_MAX_PREV_BUILDS',
               defaultValue: '1',
               description: 'How far back to look when selecting latest match (integer)'),
        booleanParam(name: 'KOJI_CLEAN_DESTINATION', defaultValue: true, description: 'Clean before download'),
        booleanParam(name: 'KOJI_CREATE_SUBDIR_PER_NVR', defaultValue: true, description: 'Create subdir per NVR')
    ]),
    // Add a job-level Poll SCM trigger (Koji will be the polled SCM via checkout below)
    pipelineTriggers([
    pollSCM('H/5 * * * *') // poll every ~5 minutes; adjust to taste
    ])
])


timestamps {
    library 'jenkins-ci-websphere'

    // Check for new Koji builds WITHOUT downloading
    def hasNewBuilds = false
    node('built-in') {
        stage('koji-check-only') {
            // Use pollSCM to check for changes without downloading
            def scmConfig = [
                $class: 'KojiSCM',
                kojiBuildProviders: [[
                    $class: 'KojiBuildProvider',
                    topUrl:      params.KOJI_TOP_URLS,
                    downloadUrl: params.KOJI_DOWNLOAD_URLS
                ]],
                kojiXmlRpcApi: [
                    $class: 'RealKojiXmlRpcApi',
                    packageName:           params.KOJI_PACKAGE_NAME,
                    arch:                  params.KOJI_PACKAGE_ARCH,
                    tag:                   params.KOJI_TAG,
                    subpackageDenylist:    params.KOJI_SUBPACKAGE_DENYLIST,
                    subpackageAllowlist:   params.KOJI_SUBPACKAGE_ALLOWLIST
                ],
                downloadDir:        params.KOJI_DOWNLOAD_DIR,
                cleanDownloadDir:   params.KOJI_CLEAN_DESTINATION,
                dirPerNvr:          params.KOJI_CREATE_SUBDIR_PER_NVR,
                maxPreviousBuilds:  params.KOJI_MAX_PREV_BUILDS as Integer
            ]
            
            // Poll SCM to check for changes (doesn't download)
            def changes = pollSCM(scm: scmConfig)
            hasNewBuilds = changes
            
            echo "New Koji builds available: ${hasNewBuilds}"
            
            // Store as environment variable for later stages
            env.HAS_NEW_KOJI_BUILDS = hasNewBuilds.toString()
        }
    }

    // THEN check if we should skip (after polling has occurred)
    // Skip if it's a seed job AND there are no new builds
    if (shouldSkipDueToSeedJob() && !hasNewBuilds) {
        echo "Skipping: seed job with no new Koji builds"
        return;
    }

    println "Now you see me!"
    try {
        println "Requesting node from " + params.ebcShortlist + " with demand ID " + params.executionId
        onEBC(
            demandId: params.executionId,
            ebcShortlist: params.ebcShortlist,
            ebcPriority: params.ebcPriority,
            autoCompleteAfterXHours: 24
        ) {
            stage('testsuite-clone') {
                reportActivity(name: 'testsuite-clone', executionId: params.executionId) {
                    println "Cloning the ${params.TEST_SUITE_URL} repo, branch ${params.TEST_SUITE_BRANCH}"
        
                    git(
                        branch: "${params.TEST_SUITE_BRANCH}",
                        url: "${params.TEST_SUITE_URL}",
                        submoduleCfg: [],  // enables submodule handling
                        changelog: false,
                        poll: false
                    )
        
                    // initialize & update submodules recursively
                    sh """
                        git submodule update --init --recursive
                    """
                }
            }
            
            stage('jvm-setup') {
                reportActivity(name: 'jvm-setup', executionId: params.executionId) {
                    // Debug: Print all Koji parameters
                    echo "=== Koji Configuration Debug ==="
                    echo "KOJI_TOP_URLS: ${params.KOJI_TOP_URLS}"
                    echo "KOJI_DOWNLOAD_URLS: ${params.KOJI_DOWNLOAD_URLS}"
                    echo "KOJI_PACKAGE_NAME: ${params.KOJI_PACKAGE_NAME}"
                    echo "KOJI_PACKAGE_ARCH: ${params.KOJI_PACKAGE_ARCH}"
                    echo "KOJI_TAG: ${params.KOJI_TAG}"
                    echo "KOJI_SUBPACKAGE_DENYLIST: ${params.KOJI_SUBPACKAGE_DENYLIST}"
                    echo "KOJI_SUBPACKAGE_ALLOWLIST: ${params.KOJI_SUBPACKAGE_ALLOWLIST}"
                    echo "KOJI_DOWNLOAD_DIR: ${params.KOJI_DOWNLOAD_DIR}"
                    echo "KOJI_CLEAN_DESTINATION: ${params.KOJI_CLEAN_DESTINATION}"
                    echo "KOJI_CREATE_SUBDIR_PER_NVR: ${params.KOJI_CREATE_SUBDIR_PER_NVR}"
                    echo "KOJI_MAX_PREV_BUILDS: ${params.KOJI_MAX_PREV_BUILDS}"
                    echo "==============================="
                    
                    // Clean the download directory before checkout
                    sh """
                        echo "=== Cleaning Download Directory ==="
                        if [ -d "${params.KOJI_DOWNLOAD_DIR}" ]; then
                            echo "Removing existing directory: ${params.KOJI_DOWNLOAD_DIR}"
                            rm -rf ${params.KOJI_DOWNLOAD_DIR}
                            echo "Directory cleaned"
                        else
                            echo "Directory ${params.KOJI_DOWNLOAD_DIR} does not exist, nothing to clean"
                        fi
                        echo "===================================="
                    """
                    
                    // Download latest Koji build
                    checkout([$class: 'KojiSCM',
                        kojiBuildProviders: [[
                            $class: 'KojiBuildProvider',
                            topUrl:      params.KOJI_TOP_URLS,
                            downloadUrl: params.KOJI_DOWNLOAD_URLS
                        ]],
                        kojiXmlRpcApi: [
                            $class: 'RealKojiXmlRpcApi',
                            packageName:           params.KOJI_PACKAGE_NAME,
                            arch:                  params.KOJI_PACKAGE_ARCH,
                            tag:                   params.KOJI_TAG,
                            subpackageDenylist:    params.KOJI_SUBPACKAGE_DENYLIST,
                            subpackageAllowlist:   params.KOJI_SUBPACKAGE_ALLOWLIST
                        ],
                        downloadDir:        params.KOJI_DOWNLOAD_DIR,
                        cleanDownloadDir:   params.KOJI_CLEAN_DESTINATION,
                        dirPerNvr:          params.KOJI_CREATE_SUBDIR_PER_NVR,
                        maxPreviousBuilds:  params.KOJI_MAX_PREV_BUILDS as Integer
                    ])
                    
                    withCredentials([usernamePassword(credentialsId: "intranetId", usernameVariable: 'intranetId_USR', passwordVariable: 'intranetId_PSW')]) {
                        // Debug: List downloaded files
                        sh """
                            echo "=== Downloaded Files Debug ==="
                            echo "Listing contents of ${params.KOJI_DOWNLOAD_DIR}:"
                            ls -laR ${params.KOJI_DOWNLOAD_DIR} || echo "Directory not found or empty"
                            echo "=============================="
                        """
                        
                        // Install RPMs from downloaded Koji build
                        sh """
                            echo "Installing RPMs from ${params.KOJI_DOWNLOAD_DIR}"
                            sudo dnf install -y ${params.KOJI_DOWNLOAD_DIR}/**/*.rpm
                        """
                    }
                }
            }

            stage('testsuite-run') {
                reportActivity(name: 'testsuite-run', executionId: params.executionId) {
                    withCredentials([usernamePassword(credentialsId: "intranetId", usernameVariable: 'intranetId_USR', passwordVariable: 'intranetId_PSW')]) {
                        sh params.TEST_COMMAND
                    }
                }
            }
        }

    } finally {
        node (label: 'built-in') {
            cleanupWorkspace()
        }
    }
}    
